---
import type { NewsItem } from '../lib/news';
import { formatTime } from '../lib/format';

interface Props {
  item: NewsItem;
}

const { item } = Astro.props;
const showOriginal = item.title.trim() !== item.titleKo.trim();
---

<article class="news" data-tags={item.tags.join('|')}>
  <div class="meta">
    <span class="source">{item.source}</span>
    <time datetime={item.publishedAt.toISOString()}>{formatTime(item.publishedAt)}</time>
    <span class="cred" title={`신뢰도 ${item.credibility}/5`}>
      <span class="visually-hidden">신뢰도 {item.credibility}/5</span>
      {[1, 2, 3, 4, 5].map((n) => <i class={n <= item.credibility ? 'on' : ''} aria-hidden="true" />)}
    </span>
  </div>

  <h3>
    <a href={item.url} target="_blank" rel="noopener noreferrer">{item.titleKo}</a>
  </h3>
  {showOriginal && <p class="orig" lang="en">{item.title}</p>}

  {item.summary && <p class="summary">{item.summary}</p>}

  {
    item.keyPoints.length > 0 && (
      <details class="points">
        <summary>핵심 내용 {item.keyPoints.length}가지</summary>
        <ul>
          {item.keyPoints.map((p) => (
            <li>{p}</li>
          ))}
        </ul>
      </details>
    )
  }

  <div class="foot">
    {item.tags.map((t) => <span class="tag">#{t}</span>)}
    <a class="read" href={item.url} target="_blank" rel="noopener noreferrer">원문 보기</a>
  </div>
</article>
