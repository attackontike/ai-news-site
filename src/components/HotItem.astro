---
import type { NewsItem } from '../lib/news';
import { formatDateTime } from '../lib/format';

interface Props {
  item: NewsItem;
  rank: number;
}

const { item, rank } = Astro.props;
const score = Math.round(item.hotScore);
---

<li class:list={['hot', { top: rank <= 3 }]}>
  <span class="rank" aria-label={`${rank}위`}>{rank}</span>
  <div>
    <div class="meta">
      <span class="source">{item.source}</span>
      <time datetime={item.publishedAt.toISOString()}>{formatDateTime(item.publishedAt)}</time>
    </div>
    <h3>
      <a href={item.url} target="_blank" rel="noopener noreferrer">{item.titleKo}</a>
    </h3>
    {item.summary && <p class="summary">{item.summary}</p>}
    <div class="heat">
      <span class="score">인기도 {score}</span>
      <span class="bar" aria-hidden="true"><span style={`width:${Math.min(100, Math.max(2, score))}%`}></span></span>
      <span>{item.coverage > 1 ? `${item.coverage}개 매체 보도` : '단독 보도'}</span>
    </div>
  </div>
</li>
