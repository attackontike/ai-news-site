---
import { getNewsData } from '../lib/news';
import { formatDateTime } from '../lib/format';

interface Props {
  active: 'week' | 'hot' | 'world';
}

const { active } = Astro.props;
const data = await getNewsData();
const invite = import.meta.env.PUBLIC_DISCORD_INVITE;

const menus = [
  { key: 'week', href: '/', label: 'AI 최근1주일 News', count: data.weekly.length },
  { key: 'hot', href: '/hot', label: 'AI Hot News', count: data.aiHot.length },
  { key: 'world', href: '/world', label: '국제 Hot News', count: data.worldHot.length },
] as const;

const updated = data.referenceTime ? formatDateTime(data.referenceTime) : '아직 없음';
---

<aside class="sidebar">
  <div class="side-top">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">N</span>
      AI 뉴스 브리프
    </a>
    <span class="updated-mobile" style="display:none">{updated} 업데이트</span>
  </div>

  <nav class="nav" aria-label="메뉴">
    {
      menus.map((m) => (
        <a href={m.href} data-key={m.key} aria-current={m.key === active ? 'page' : undefined}>
          {m.label}
          <span class="count" aria-label={`${m.count}건`}>{m.count}</span>
        </a>
      ))
    }
  </nav>

  <div class="side-foot">
    <span>마지막 업데이트<br /><strong>{updated}</strong></span>
    <span>매일 오전 7시에 새 소식을 모읍니다.</span>
    {
      invite && (
        <a class="discord" href={invite} target="_blank" rel="noopener noreferrer">
          Discord에서 알림 받기
        </a>
      )
    }
  </div>
</aside>
