---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';

interface Props {
  title: string;
  description: string;
  section: 'weekly' | 'hot' | 'world';
}
const { title, description, section } = Astro.props;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <title>{title} | AI 뉴스 브리프</title>
  </head>
  <body data-section={section}>
    <a class="skip" href="#main">본문으로 건너뛰기</a>
    <div class="shell">
      <Sidebar current={section} />
      <main id="main" class="main">
        <slot />
      </main>
    </div>
    <script>
      // 모바일 상단 메뉴 높이만큼 날짜 제목이 붙도록 보정
      const rail = document.querySelector<HTMLElement>('.rail');
      const mq = window.matchMedia('(max-width: 900px)');
      const sync = () => document.documentElement.style.setProperty('--top-h', mq.matches && rail ? `${rail.offsetHeight}px` : '0px');
      if (rail) new ResizeObserver(sync).observe(rail);
      mq.addEventListener('change', sync);
      sync();
      if (mq.matches) document.querySelector('.nav-item[aria-current]')?.scrollIntoView({ inline: 'center', block: 'nearest' });
    </script>
  </body>
</html>
