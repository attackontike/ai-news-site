---
import BaseLayout from '../layouts/BaseLayout.astro';
import HotPage from '../components/HotPage.astro';
import { getNewsData, RULES } from '../lib/news';

const { worldHot } = await getNewsData();
---

<BaseLayout
  title="국제 Hot News"
  description="최근 3일 세계 주요 뉴스 중 여러 매체가 함께 다룬 소식을 순위로 보여 줍니다."
  section="world"
>
  <HotPage
    title="국제 Hot News"
    lead={`최근 ${RULES.worldHot.days}일 세계 주요 뉴스 중 인기도 상위 ${RULES.worldHot.limit}건입니다.`}
    items={worldHot}
  />
</BaseLayout>
