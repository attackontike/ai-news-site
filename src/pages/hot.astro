---
import BaseLayout from '../layouts/BaseLayout.astro';
import HotPage from '../components/HotPage.astro';
import { getNewsData, RULES } from '../lib/news';

const { aiHot } = await getNewsData();
---

<BaseLayout
  title="AI Hot News"
  description="최근 3일 AI 기사 중 여러 매체가 함께 다룬 화제의 소식을 순위로 보여 줍니다."
  section="hot"
>
  <HotPage
    title="AI Hot News"
    lead={`최근 ${RULES.aiHot.days}일 AI 기사 중 인기도 상위 ${RULES.aiHot.limit}건입니다. 여러 매체가 함께 다룬 소식일수록 위에 옵니다.`}
    items={aiHot}
  />
</BaseLayout>
