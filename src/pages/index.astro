---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsItem from '../components/NewsItem.astro';
import { getNewsData, groupByDay, topTags, RULES } from '../lib/news';
import { formatDayHeading, formatDateTime } from '../lib/format';

const data = await getNewsData();
const days = groupByDay(data.weekly);
const tags = topTags(data.weekly);
const Briefing = data.latest ? (await render(data.latest)).Content : null;
const hasBriefing = Boolean(data.latest?.body?.trim());
---

<BaseLayout
  title="AI 최근1주일 News"
  description="신뢰도 높은 최근 7일 AI 기사를 한국어 요약과 함께 모았습니다."
  section="week"
>
  <header class="page-head">
    <h1>AI 최근1주일 News</h1>
    <p>최근 {RULES.weekly.days}일 동안 나온 AI 기사 중 신뢰도 {RULES.weekly.minCredibility} 이상만 모았습니다.</p>
  </header>

  {
    Briefing && hasBriefing && (
      <section class="briefing" aria-labelledby="briefing-title">
        <h2 id="briefing-title">
          오늘의 브리핑
          {data.referenceTime && <span class="when">{formatDateTime(data.referenceTime)}</span>}
        </h2>
        <Briefing />
      </section>
    )
  }

  {
    tags.length > 0 && (
      <div class="filters" role="group" aria-label="태그로 거르기">
        <button class="chip" type="button" data-tag="" aria-pressed="true">전체</button>
        {tags.map((t) => (
          <button class="chip" type="button" data-tag={t} aria-pressed="false">
            #{t}
          </button>
        ))}
      </div>
    )
  }

  {
    days.length === 0 ? (
      <p class="empty">아직 표시할 기사가 없습니다. n8n 워크플로를 한 번 실행하면 이곳에 기사가 채워집니다.</p>
    ) : (
      days.map((day) => (
        <section class="day" data-day>
          <h2 class="day-head">
            {formatDayHeading(day.key)}
            <span class="n">{day.items.length}건</span>
          </h2>
          <div class="day-list">
            {day.items.map((item) => (
              <NewsItem item={item} />
            ))}
          </div>
        </section>
      ))
    )
  }
  <p class="empty" id="filter-empty" hidden>이 태그가 붙은 기사가 없습니다. 다른 태그를 고르거나 전체를 눌러 주세요.</p>
</BaseLayout>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const items = document.querySelectorAll<HTMLElement>('.news');
  const days = document.querySelectorAll<HTMLElement>('[data-day]');
  const empty = document.getElementById('filter-empty');

  function applyFilter(tag: string) {
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.tag === tag)));
    items.forEach((el) => {
      const tags = (el.dataset.tags ?? '').split('|');
      el.hidden = tag !== '' && !tags.includes(tag);
    });
    let visibleDays = 0;
    days.forEach((d) => {
      const n = d.querySelectorAll('.news:not([hidden])').length;
      d.hidden = n === 0;
      const count = d.querySelector('.n');
      if (count) count.textContent = `${n}건`;
      if (n > 0) visibleDays++;
    });
    if (empty) empty.hidden = visibleDays > 0 || days.length === 0;
  }

  chips.forEach((c) => c.addEventListener('click', () => applyFilter(c.dataset.tag ?? '')));
</script>
